---
# LLVM-based C++20 formatting standard
BasedOnStyle: LLVM
Standard: c++20
Language: Cpp

# Indentation & Alignment
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
IndentCaseLabels: true
IndentPPDirectives: None

# Line Width & Wrapping
ColumnLimit: 120
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements

# Pointer & Reference Alignment
PointerAlignment: Left
ReferenceAlignment: Left

# Include Sorting & Categorization
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # 0. Primary matching header (Foo.cpp -> Foo.h) placed at the very top
  - Regex: '^"((\.\./)*|\w+/)*[A-Za-z0-9_]+\.h"'
    Priority: 1
  # 1. Windows socket headers (must precede windows.h)
  - Regex: '^<winsock2\.h>'
    Priority: 2
  # 2. Windows core base headers (must precede other windows sdk headers)
  - Regex: '^<windows\.h>'
    Priority: 3
  # 3. Standard C/C++ library headers (<vector>, <string>, etc.) and third-party headers (<spdlog/...>, <curl/...>)
  - Regex: '^<.*'
    Priority: 4
  # 4. Platform abstraction layer
  - Regex: '^"OmniPlatform/.*'
    Priority: 5
  # 5. Internal utility & domain components
  - Regex: '^"Utils/.*'
    Priority: 6
  # 6. Hook & Manager subsystems
  - Regex: '^"(Hook|Manager)/.*'
    Priority: 7
  # 7. Fallback for all other includes
  - Regex: '.*'
    Priority: 8
